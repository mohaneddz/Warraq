# Initial Administrator Credentials for Warraq Bootstrap
WARRAQ_ADMIN_USERNAME=admin
WARRAQ_ADMIN_PASSWORD=change-me-before-first-run
# Optional — if unset, the bootstrap admin gets a synthetic <username>@warraq.local address
WARRAQ_ADMIN_EMAIL=

# Supabase — server-side (Rust). SECRET_KEY is the service-role key: keep it out of the
# frontend bundle entirely, it is only ever read by src-tauri/src/admin.rs.
PROJECT_ID=
PUBLISHABLE_KEY=
SECRET_KEY=
DIRECT_STRING=postgresql://postgres:[YOUR-PASSWORD]@db.<project-ref>.supabase.co:5432/postgres

# Supabase — frontend (Vite). Only VITE_-prefixed vars are exposed to the app bundle; the
# anon/publishable key is meant to be public and is protected by RLS, not secrecy.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
